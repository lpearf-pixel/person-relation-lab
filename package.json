{
  "name": "person-relation-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "verify": "npm run lint && npm run test && npm run build",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "repair:projections": "node dist/db/repair-projections.js",
    "process:secondary": "node dist/db/run-secondary-processing.js",
    "local-coder": "node dist/tools/local-coder.js",
    "benchmark:generate": "npm run build && node dist/benchmark/xlsx.js generate",
    "benchmark:read": "npm run build && node dist/benchmark/xlsx.js read"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "exceljs": "latest",
    "fastify": "latest",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "eslint": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
